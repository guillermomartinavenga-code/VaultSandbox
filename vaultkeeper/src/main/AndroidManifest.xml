<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".VaultKeeperApp"
        android:allowBackup="false"
        android:label="VaultKeeper"
        android:theme="@style/Theme.VaultKeeper"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            v0.8: exported="false" — the first line of defense, ahead of hardening query()/
            openFile()/the DB itself (v0.3/v0.5/v0.7). v0.1-v0.7 kept this exported="true" purely
            so VaultRaider could demonstrate vulns #1-#3 and their fixes; the hypothetical
            Chrome-extension companion app (narrative only, never implemented — see
            docs/practical-evidence.md) would need to actually be bundled/signed with VaultKeeper
            itself to use this provider now, not reach it as an unrelated third-party app. An
            exported="true" + signature-permission variant was validated too (same doc) and then
            reverted — not needed here since there's no real signed companion app in this repo.
        -->
        <provider
            android:name=".data.provider.VaultContentProvider"
            android:authorities="dev.guillermomartin.vaultkeeper.provider"
            android:exported="false" />

    </application>

</manifest>
