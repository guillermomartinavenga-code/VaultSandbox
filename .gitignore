# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Excepción: el jar del wrapper de Gradle sí se commitea (necesario para que
# ./gradlew funcione en cualquier clon del repo sin depender de un Gradle local).
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Android / Gradle build output
*/build/
/build/
.gradle/
.cxx/
captures/
*.apk

# Local SDK path — machine-specific, never shared
local.properties

# Android Studio project files (not shared, regenerated by Android Studio)
.idea/
*.iml

# Nota: las dos keystores de debug en keystores/*.jks SÍ se commitean a propósito
# (ver docs/evidencia-practica-es.md) — no agregar una regla que las excluya.